{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Calibri, Arial, sans-serif",
    "fontSize": "15px",
    "primaryColor": "#EEEAFB",
    "primaryTextColor": "#1A1A24",
    "primaryBorderColor": "#302082",
    "lineColor": "#4A339E",
    "secondaryColor": "#E8EEF5",
    "tertiaryColor": "#F7F5FC",
    "background": "#FFFFFF"
  },
  "flowchart": {
    "curve": "basis",
    "htmlLabels": true,
    "useMaxWidth": false
  },
  "sequence": {
    "useMaxWidth": false,
    "wrap": true,
    "diagramMarginX": 24,
    "diagramMarginY": 24
  },
  "er": {
    "useMaxWidth": false,
    "diagramPadding": 24
  }
}
