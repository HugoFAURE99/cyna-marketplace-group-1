{
  "name": "webapp-cyna",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "invoices:backfill": "node --env-file=.env.local scripts/maintenance/backfill-stripe-invoices.mjs",
    "subscriptions:backfill": "node --env-file=.env.local scripts/maintenance/backfill-stripe-subscriptions.mjs",
    "db:types": "npm run db:types:local",
    "db:types:local": "supabase gen types typescript --local > src/types/database.types.ts",
    "db:types:linked": "supabase gen types typescript --linked > src/types/database.types.ts",
    "db:types:check": "node scripts/check-supabase-types.mjs --local",
    "db:types:check:linked": "node scripts/check-supabase-types.mjs --linked",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "test": "vitest run",
    "smoke:routes": "node scripts/smoke-customer-routes.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.10.0",
    "@hookform/resolvers": "^5.2.2",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^10.65.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "fuse.js": "^7.4.2",
    "lucide-react": "^1.8.0",
    "next": "^16.2.10",
    "next-intl": "^4.13.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.72.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "sass": "^1.99.0",
    "shadcn": "^4.2.0",
    "sharp": "^0.35.1",
    "stripe": "^22.3.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "pdfjs-dist": "^6.1.200",
    "supabase": "2.109.1",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^4.1.10"
  }
}
