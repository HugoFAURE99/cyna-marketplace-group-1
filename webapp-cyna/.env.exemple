# Supabase → dashboard.supabase.co > ton projet > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyxxxx
SUPABASE_SERVICE_ROLE_KEY=eyxxxx

# Stripe → dashboard.stripe.com > Developers > API Keys
STRIPE_SECRET_KEY=sk_test_xxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxx

# Google Gemini (CynAI chatbot) → aistudio.google.com > Get API key
GEMINI_API_KEY=xxxx

# adresse du site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

#webhook stripe:
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxx

# Portail client Stripe (facultatif : CYNA peut créer une configuration compatible)
STRIPE_CUSTOMER_PORTAL_CONFIGURATION_ID=bpc_xxxxxxx

# Sentry (à renseigner dans le contexte Production Netlify uniquement)
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
SENTRY_ORG=cyna
SENTRY_PROJECT=cyna-marketplace
SENTRY_AUTH_TOKEN=sntrys_xxxxxxx
